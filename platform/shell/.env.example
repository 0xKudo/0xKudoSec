# Shell (Vite) environment — copy to .env and fill in.
# These are public SPA values, not secrets: Auth0 Dashboard > Applications > (SPA app).
# The audience is the API identifier from Auth0 Dashboard > APIs.
VITE_AUTH0_DOMAIN=auth.0xkudo.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://tools.laynekudo.com/api
